import asyncio
from pathlib import Path
from urllib.parse import urljoin
from bs4 import BeautifulSoup
from playwright.async_api import async_playwright

OUTPUT_DIR = Path("./extracted_content")


def clean_text(text: str) -> str:
    """Removes excessive whitespace while preserving structure."""
    lines = (line.strip() for line in text.splitlines())
    return "\n".join(chunk for chunk in lines if chunk)


async def extract_and_save_markdown(url: str, output_filename: str = "scraped_summary.md"):
    """Scrapes structured text, metadata, and media links, saving to a Markdown file."""
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    output_path = OUTPUT_DIR / output_filename

    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True)
        context = await browser.new_context(
            user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        )
        page = await context.new_page()

        print(f"[*] Navigating to {url}...")
        await page.goto(url, wait_until="networkidle")

        content = await page.content()
        soup = BeautifulSoup(content, "html.parser")

        # 1. Page Title & Meta Description
        page_title = soup.title.string.strip() if soup.title else "No Title Found"
        meta_desc_tag = soup.find("meta", attrs={"name": "description"}) or soup.find("meta", attrs={"property": "og:description"})
        meta_description = meta_desc_tag["content"].strip() if meta_desc_tag and meta_desc_tag.get("content") else "No Meta Description"

        # 2. Extract Headings & Main Paragraphs
        body_content = []
        for element in soup.find_all(["h1", "h2", "h3", "h4", "p", "ul", "ol", "blockquote"]):
            tag_name = element.name
            text = element.get_text().strip()

            if not text:
                continue

            if tag_name == "h1":
                body_content.append(f"\n# {text}\n")
            elif tag_name == "h2":
                body_content.append(f"\n## {text}\n")
            elif tag_name == "h3":
                body_content.append(f"\n### {text}\n")
            elif tag_name == "h4":
                body_content.append(f"\n#### {text}\n")
            elif tag_name == "blockquote":
                body_content.append(f"> {text}\n")
            elif tag_name in ["ul", "ol"]:
                for li in element.find_all("li"):
                    li_text = li.get_text().strip()
                    if li_text:
                        body_content.append(f"- {li_text}")
                body_content.append("")
            elif tag_name == "p":
                body_content.append(f"{text}\n")

        # 3. Extract Links
        links = []
        for a_tag in soup.find_all("a", href=True):
            link_text = a_tag.get_text().strip() or "Link"
            href = urljoin(url, a_tag["href"])
            if href.startswith("http"):
                links.append((link_text, href))

        # 4. Extract Images
        images = []
        for img_tag in soup.find_all("img"):
            alt_text = img_tag.get("alt", "").strip() or "Image"
            src = img_tag.get("src") or img_tag.get("data-src")
            if src:
                images.append((alt_text, urljoin(url, src)))

        await browser.close()

        # Build Markdown document structure
        markdown_output = []
        markdown_output.append(f"# Scraped Report: {page_title}")
        markdown_output.append(f"**Source URL:** {url}")
        markdown_output.append(f"**Meta Description:** {meta_description}\n")
        markdown_output.append("---")
        markdown_output.append("## Article & Page Content\n")
        markdown_output.extend(body_content)

        markdown_output.append("\n---")
        markdown_output.append("## Extracted Links\n")
        for text, href in links[:20]:  # Cap at top 20 links
            markdown_output.append(f"- [{text}]({href})")

        markdown_output.append("\n---")
        markdown_output.append("## Embedded Images\n")
        for alt, src in images[:10]:  # Cap at top 10 images
            markdown_output.append(f"- ![ {alt} ]({src})")

        # Write to file
        full_text = "\n".join(markdown_output)
        with open(output_path, "w", encoding="utf-8") as f:
            f.write(full_text)

        print(f"[+] Successfully exported content to: {output_path.resolve()}")


if __name__ == "__main__":
    target = "https://webscraper.io/"  # Replace with target website
    asyncio.run(extract_and_save_markdown(target, "scraped_data.md"))
